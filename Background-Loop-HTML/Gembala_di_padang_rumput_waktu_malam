<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Christmas Loop 15FPS - Emoji Edition</title>
    <style>
        /* RESET & BASE */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background: linear-gradient(180deg, #010514 0%, #061330 50%, #0d214a 100%);
        }

        /* BACKGROUND SKY (GLOW) */
        #sky-glow {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(circle at 50% 20%, rgba(50, 80, 140, 0.4) 0%, rgba(0, 0, 0, 0) 65%);
            z-index: 1;
        }

        /* CHRISTMAS STAR */
        #star-container {
            position: absolute;
            top: 20%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .star-core {
            width: 6px;
            height: 6px;
            background-color: #ffffff;
            border-radius: 50%;
            box-shadow: 
                0 0 15px 8px rgba(255, 255, 255, 0.9),
                0 0 40px 20px rgba(255, 240, 180, 0.7),
                0 0 90px 40px rgba(255, 220, 100, 0.4);
            animation: pulse-star 4s infinite alternate ease-in-out;
        }

        /* ROTATING RAYS */
        #rays {
            position: absolute;
            width: 400px;
            height: 400px;
            animation: spin-rays 40s linear infinite;
        }

        .ray {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, 
                rgba(255,255,255,0) 0%, 
                rgba(255,245,200,0.4) 45%, 
                rgba(255,255,255,1) 50%, 
                rgba(255,245,200,0.4) 55%, 
                rgba(255,255,255,0) 100%);
            transform-origin: center center;
            margin-top: -0.5px;
            margin-left: -200px;
        }

        .ray:nth-child(2) { transform: rotate(45deg); }
        .ray:nth-child(3) { transform: rotate(90deg); }
        .ray:nth-child(4) { transform: rotate(135deg); }

        /* CANVAS FOR SNOW AND STARS */
        #particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 3;
            pointer-events: none;
        }

        /* SVG LANDSCAPE (HILLS) */
        #landscape-container {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 4;
            pointer-events: none;
        }

        svg {
            width: 100%;
            height: 100%;
        }

        /* EMOJI CHARACTERS CONTAINER */
        #characters-container {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 5;
            pointer-events: none;
            /* Container relative bounds for absolute emoji positioning */
        }

        .emoji-art {
            position: absolute;
            filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.8));
            transform-origin: bottom center;
        }

        /* Responsive emoji sizing using clamp */
        .shepherd {
            font-size: clamp(60px, 12vw, 150px);
            left: 20%;
            bottom: 15%;
            animation: breathe 4s infinite alternate ease-in-out;
        }

        .sheep {
            font-size: clamp(40px, 8vw, 100px);
        }

        .sheep-1 {
            left: 45%;
            bottom: 12%;
            animation: breathe 3.5s infinite alternate-reverse ease-in-out;
        }

        .sheep-2 {
            left: 60%;
            bottom: 18%;
            font-size: clamp(30px, 6vw, 80px); /* Slightly smaller/further */
            animation: breathe 4.5s infinite alternate ease-in-out;
        }

        .sheep-3 {
            left: 75%;
            bottom: 10%;
            animation: breathe 5s infinite alternate-reverse ease-in-out;
        }

        /* KEYFRAMES */
        @keyframes pulse-star {
            0% { transform: scale(0.8); opacity: 0.7; }
            100% { transform: scale(1.2); opacity: 1; }
        }

        @keyframes spin-rays {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes breathe {
            0% { transform: scaleY(0.95) translateY(2%); }
            100% { transform: scaleY(1.02) translateY(0%); }
        }
    </style>
</head>
<body>

    <!-- Ambient Sky Glow -->
    <div id="sky-glow"></div>

    <!-- The Star of Bethlehem -->
    <div id="star-container">
        <div id="rays">
            <div class="ray"></div>
            <div class="ray"></div>
            <div class="ray"></div>
            <div class="ray"></div>
        </div>
        <div class="star-core"></div>
    </div>

    <!-- Particle System (Throttled to 15 FPS) -->
    <canvas id="particles"></canvas>

    <!-- Vector Silhouettes (Hills only) -->
    <div id="landscape-container">
        <svg viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMax slice">
            <!-- BACKGROUND HILL -->
            <path d="M0,1080 L0,700 Q480,500 1100,700 T1920,600 L1920,1080 Z" fill="#04091a"/>
            <!-- MIDDLE HILL -->
            <path d="M0,1080 L0,850 Q600,700 1300,880 T1920,780 L1920,1080 Z" fill="#02040d"/>
            <!-- FRONT HILL -->
            <path d="M-100,1080 L-100,980 Q500,850 1100,1020 T2000,930 L2000,1080 Z" fill="#000000"/>
        </svg>
    </div>

    <!-- Emoji Characters -->
    <div id="characters-container">
        <div class="emoji-art shepherd">🧑‍🌾</div>
        <div class="emoji-art sheep sheep-1">🐑</div>
        <div class="emoji-art sheep sheep-2">🐑</div>
        <div class="emoji-art sheep sheep-3">🐑</div>
    </div>

    <!-- Logic for Canvas Particles (15 FPS Optimized) -->
    <script>
        const canvas = document.getElementById('particles');
        const ctx = canvas.getContext('2d');
        
        let width, height;
        let particles = [];
        let staticStars = [];

        // Setup Canvas Size
        function resize() {
            width = window.innerWidth;
            height = window.innerHeight;
            canvas.width = width;
            canvas.height = height;
            initParticles();
        }

        window.addEventListener('resize', resize);

        class SnowParticle {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.size = Math.random() * 2.5 + 0.5;
                // Speed increased slightly because we are jumping frames at 15fps
                this.speedY = Math.random() * 2 + 1; 
                this.speedX = (Math.random() - 0.5) * 1;
                this.opacity = Math.random() * 0.5 + 0.1;
            }

            update() {
                this.y += this.speedY;
                this.x += this.speedX;

                if (this.y > height) {
                    this.y = -10;
                    this.x = Math.random() * width;
                }
            }

            draw() {
                ctx.fillStyle = `rgba(255, 255, 255, ${this.opacity})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        class StaticStar {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * (height * 0.6); 
                this.size = Math.random() * 1.5 + 0.5;
                this.baseOpacity = Math.random() * 0.5 + 0.2;
                // Faster blink because 15fps updates less often
                this.blinkSpeed = Math.random() * 0.1 + 0.05; 
                this.angle = Math.random() * Math.PI * 2;
            }

            update() {
                this.angle += this.blinkSpeed;
            }

            draw() {
                const currentOpacity = this.baseOpacity + Math.sin(this.angle) * 0.4;
                ctx.fillStyle = `rgba(255, 255, 255, ${Math.max(0, currentOpacity)})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function initParticles() {
            particles = [];
            staticStars = [];
            
            // Reduced particle count slightly to further optimize screen sharing
            const snowCount = Math.floor((width * height) / 15000); 
            for (let i = 0; i < snowCount; i++) {
                particles.push(new SnowParticle());
            }

            const starCount = Math.floor((width * height) / 10000);
            for (let i = 0; i < starCount; i++) {
                staticStars.push(new StaticStar());
            }
        }

        // --- 15 FPS THROTTLE LOGIC ---
        let lastRenderTime = 0;
        const fps = 15;
        const frameInterval = 1000 / fps;

        function animate(currentTime) {
            requestAnimationFrame(animate);

            // Calculate time since last frame
            const deltaTime = currentTime - lastRenderTime;

            // Only update and draw if enough time has passed (15 fps)
            if (deltaTime >= frameInterval) {
                // Adjust lastRenderTime to maintain consistent 15fps timing
                lastRenderTime = currentTime - (deltaTime % frameInterval);

                ctx.clearRect(0, 0, width, height);
                
                staticStars.forEach(star => {
                    star.update();
                    star.draw();
                });

                particles.forEach(p => {
                    p.update();
                    p.draw();
                });
            }
        }

        // Initialize
        resize();
        requestAnimationFrame(animate); // Start loop

    </script>
</body>
</html>
